# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/field_crm

# Tests only. The database name MUST end in _test; the suite wipes it on every run.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/field_crm_test

# Signs login sessions: a long random string. Changing it signs everyone out.
JWT_SECRET=

# Production only (HTTPS):
# COOKIE_SECURE=true
# CORS_ORIGINS=["https://your-app-domain"]

# Official Zoho CRM MCP server URL (secret). Backend only, never the phone app.
ZOHO_MCP_URL=

# Optional Zoho settings (defaults shown). The two *_REF_FIELD values are custom text fields
# the Zoho admin creates (marked unique) to hold OUR ids, for duplicate-proof retries.
# ZOHO_MEETING_VENUE=Client location
# ZOHO_LEAD_REF_FIELD=
# ZOHO_MEETING_REF_FIELD=
